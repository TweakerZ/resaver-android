<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The `launcher` flavor only differs from `iconless` by this filter:
         it puts ReSaver in the app drawer. Everything else (applicationId,
         version, the OPEN action used by Skyrim Mod Loader) is shared. -->
    <application>
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>